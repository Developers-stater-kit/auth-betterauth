{
    "type": "authentication",
    "package": "betterauth",
    "repo": {
        "name": "auth-betterauth",
        "branch": "base"
    },
    "envVars": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL"
    ],
    "dependencies": [
        "better-auth"
    ],
    "devDependencies": [],
    "structure": {
        "server": {
            "name": "auth.ts",
            "path": null
        },
        "client": {
            "name" : "auth-client.ts",
            "path" : "auth-client.txt"
        },
        "api": {
            "name": "route.ts",
            "path": "route.txt"
        },
        "middleware": {
            "name": "middleware.ts",
            "path": "middleware.txt"
        }
    },
    "orms": {
        "drizzle": "adapters/drizzle.txt",
        "prisma": "adapters/prisma.txt"
    },
    "engines": {
        "pg": "engines/pg.txt",
        "mysql": "engines/mysql.txt"
    },
    "dbEngine": {
        "pg": {
            "drizzle": "pg",
            "prisma": "postgresql"
        },
        "mysql": {
            "drizzle": "mysql",
            "prisma": "mysql"
        }
    },
    "ui": {
        "path": "ui/",
        "component-files": [
            "signup-form.tsx",
            "signin-form.tsx",
            "forgot-pass.tsx", 
            "reset-pass.tsx",
            "oauth-button.tsx",
            "signout-button.tsx"
        ],
        "dependencies": ["zod","react-hook-form","sonner","next/navigation","next/link","lucide-react", "react-icons"],
        "shadcn-components": ["button","form","input"]
    },
    "routes": {
        "nextjs-app-router": {
            "routeKey": "_next-js-app-router_"
        },
        "nextjs-pages-router": {
            "routeKey": "_next-js-pages-router_"
        }
    },
    "features": {
        "credentials": {
            "path": "features/credentials/drizzle-credential.txt"
        },
        "Oauth": {
            "path": "features/Oauth/drizzle-Oauth.txt",
            "providers": [
                {
                    "name": "Github",
                    "metadata": {
                        "envVars": [
                            "GITHUB_CLIENT_ID",
                            "GITHUB_CLIENT_SECRET"
                        ]
                    }
                },
                {
                    "name": "Google",
                    "metadata": {
                        "envVars": [
                            "GOOGLE_CLIENT_ID",
                            "GOOGLE_CLIENT_SECRET"
                        ]
                    }
                }
            ]
        }
    }
}
